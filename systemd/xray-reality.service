[Unit]
Description=Xray REALITY with persistent monthly quotas
After=network-online.target
Wants=network-online.target
[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/reality_manager.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/xray-reality /var/lib/xray-quota
[Install]
WantedBy=multi-user.target
